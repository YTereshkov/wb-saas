APP_NAME=SellerScope
APP_ENV=local
WB_API_TIMEOUT=20
WB_API_CONNECT_TIMEOUT=5
WB_CLIENT_SECRET=
WB_SANDBOX_CONTENT_API_URL=https://content-api-sandbox.wildberries.ru
WB_SANDBOX_STATISTICS_API_URL=https://statistics-api-sandbox.wildberries.ru
WB_HISTORICAL_REPORT_MAX_BYTES=100000000
SELLERSCOPE_SYNC_CADENCE_MINUTES=30
SELLERSCOPE_SYNC_STALLED_AFTER_MINUTES=90
SELLERSCOPE_QUEUE_BACKLOG_ALERT=250
SELLERSCOPE_SYNC_RETRY_BASE_SECONDS=30
SELLERSCOPE_SYNC_RETRY_MAX_SECONDS=900
SELLERSCOPE_SYNC_RETRY_AFTER_MAX_SECONDS=86400
HORIZON_NAME=SellerScope
HORIZON_PATH=horizon
HORIZON_ALLOWED_EMAILS=
HORIZON_ALERT_EMAIL=
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_UID=1000
APP_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sellerscope
DB_USERNAME=sellerscope
DB_PASSWORD=sellerscope
DB_SSLMODE=prefer
DB_SSLROOTCERT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
REDIS_QUEUE_RETRY_AFTER=960
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

SELLERSCOPE_DEMO_EMAIL=demo@sellerscope.local
SELLERSCOPE_DEMO_PASSWORD=SellerScopeDemo1!
SELLERSCOPE_DEMO_TOKEN=demo-sellerscope-2026

MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
